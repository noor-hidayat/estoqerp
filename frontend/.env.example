# URL API backend. Default "/api" (dev: di-proxy Vite ke http://localhost:3001).
# Jika backend di host terpisah, isi URL absolut, misal: http://localhost:3001/api
VITE_API_URL=/api
# Mode data frontend (issue #3: frontend-first).
# - "local": CRUD via LocalStorage, tanpa backend/login (default).
# - "api": via Backend REST API (fase backend, butuh login/JWT).
VITE_DATA_MODE=local
