{
  "name": "@stockopname/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-dummy": "tsx src/db/seed-dummy.ts",
    "db:seed-transfer": "tsx src/db/seed-transfer-bulk.ts",
    "db:backfill-transfer": "tsx src/db/apply-transfer-effects.ts",
    "db:backfill-ids": "tsx src/db/migrate-opname.ts",
    "db:backfill-movement-ids": "tsx src/db/backfill-movement-ids.ts",
    "db:migrate-rbac": "tsx src/db/migrate-rbac.ts",
    "db:migrate-opname": "tsx src/db/migrate-opname.ts"

  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "globals": "^17.9.0",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
